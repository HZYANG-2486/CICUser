+    private void FillKeywordList(string gridName, KeywordScope scope, ListBox list, string? filter)
+    {
+        if (list == null)
+        {
+            return;
+        }
+
+        IEnumerable<KeywordDescriptor> items = KeywordCatalog.ForScope(scope);
+
+        var keyword = (filter ?? "").Trim();
+        if (keyword.Length > 0)
+        {
